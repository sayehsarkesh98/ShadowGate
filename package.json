{
  "name": "edge-manager",
  "version": "1.0.0",
  "description": "Professional Edge Tunnel Management System with D1 Database",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute edge-manager-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute edge-manager-db --local --file=./schema.sql",
    "db:shell": "wrangler d1 shell edge-manager-db"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "d1",
    "management",
    "edge-tunnel"
  ],
